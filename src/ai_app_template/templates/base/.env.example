# ===== 供应商密钥 =====
# 默认档（flash=gpt-4o-mini, pro=gpt-4o）使用 OpenAI
OPENAI_API_KEY=sk-xxxx
# 跨供应商兜底档 backup=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxx

# 自建/代理服务（vLLM、OneAPI 等）可覆盖基础地址
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# ===== 模型注册表覆盖（嵌套用双下划线） =====
# 示例：把 flash 档换成通义千问 Turbo
# APP_MODELS__FLASH__MODEL_ID=qwen-turbo
# APP_MODELS__FLASH__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# APP_MODELS__FLASH__API_KEY_ENV=DASHSCOPE_API_KEY
# APP_MODELS__FLASH__PRICE_PER_M_INPUT=0.0006
# APP_MODELS__FLASH__PRICE_PER_M_OUTPUT=0.0018

# ===== 网关行为 =====
# APP_GATEWAY_MAX_RETRIES=2
# APP_GATEWAY_BACKOFF_BASE_S=1.0
# APP_BREAKER_FAILURE_THRESHOLD=3
# APP_BREAKER_COOLDOWN_S=60

# ===== 可观测性（可选，需 pip install '.[observability]'） =====
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
